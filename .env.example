# Copia este archivo a  .env  y rellena los valores reales.
# .env está en .gitignore y NUNCA debe subirse al repositorio.
#
# Solo se necesita si vas a usar el script opcional tools/check-duplicado.py
# (consulta la API de Notion para detectar prospectos duplicados desde la terminal).
#
# Token de integración interna de Notion con acceso de LECTURA a la base "Prospectos".
# Se crea en: https://www.notion.so/my-integrations  ->  New integration  ->  Internal
# Después: en la base Prospectos -> ... -> Connections -> conectar la integración.
NOTION_TOKEN=

# ID de la data source (colección) de la base Prospectos. Ya conocido:
NOTION_PROSPECTOS_DATASOURCE=88376280-f3f7-4ae7-a9db-34144929c8fe
